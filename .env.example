# Variáveis de ambiente — Kolo Família
# Copie para .env.local (apps/web) e preencha conforme cada fase do Roadmap.

# ============================================================
# Fase 2 — Supabase (Auth, DB, Storage)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Fase 4 — Anthropic (Claude para skills e parser da Ayla)
# ============================================================
ANTHROPIC_API_KEY=
# Modelo principal (skills) e leve (router, parser da Ayla)
# Aliases preferidos — ver shared/models.md no skill claude-api.
ANTHROPIC_MODEL_PRINCIPAL=claude-sonnet-4-6
ANTHROPIC_MODEL_LEVE=claude-haiku-4-5

# ============================================================
# Fase 6 — Stripe (Pagamento)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MENSAL=
STRIPE_PRICE_ID_ANUAL=

# ============================================================
# Fase 7 — Ayla (Z-API + n8n)
# ============================================================
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
# Provedor WhatsApp em uso. Trocar para "cloud_api" na Fase 15.
WHATSAPP_PROVIDER=zapi

# Ayla
# Header secreto que valida origem do webhook Z-API (n8n manda esse header).
AYLA_WEBHOOK_SECRET=
# Authorization Bearer secret que protege o cron interno da Ayla.
CRON_SECRET=

# ============================================================
# Fase 9 — Geração de imagem e voz
# ============================================================
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Ou Replicate (alternativa)
REPLICATE_API_TOKEN=

# ============================================================
# Email (SMTP — para emails transacionais customizados do app Next)
# ============================================================
# Provedor: Brevo (smtp-relay.brevo.com). Pode trocar.
# IMPORTANTE: emails de AUTH (signup/recuperar senha) são enviados pelo
# Supabase Auth (GoTrue), NÃO pelo Next. Configure separadamente as envs
# GOTRUE_SMTP_* no serviço Supabase Auth (Easypanel).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# Fase 12 — Observabilidade
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================
# App config
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kolo Família
